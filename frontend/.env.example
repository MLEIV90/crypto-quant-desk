# URL base de la API REST (Fase 8a, api/main.py). Copiá este archivo a
# ".env.local" y ajustá el valor si tu API corre en otro host/puerto —
# ".env.local" queda fuera de git (ver .gitignore), así cada quien puede
# apuntar a su propia instancia sin pisar la de otro.
#
# Default si no se define (ver src/api.ts): http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
